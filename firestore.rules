rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================
    // 🔐 Admin Helper Function
    // =========================
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isOwner(ownerId) {
      return request.auth != null && request.auth.uid == ownerId;
    }

    // =========================
    // 📅 Availability Calendar Helpers
    // =========================
    function isValidAvailabilityStatusList(values) {
      return values.hasOnly([
        'available',
        'available-fullday',
        'available-halfday-morning',
        'available-halfday-evening',
        'unavailable',
        'unavailable-fullday',
        'unavailable-halfday-morning',
        'unavailable-halfday-evening',
        'busy',
        'halfday',
        'halfday-morning',
        'halfday-evening',
        'halfbooked-halfunavailable-morning',
        'halfbooked-halfunavailable-evening'
      ]);
    }

    function isValidAvailabilityMap(m) {
      return m is map
        && m.size() <= 5000
        && isValidAvailabilityStatusList(m.values());
    }

    // =========================
    // Conversations (chat) - Legacy
    // =========================
    match /conversations/{conversationId} {
      allow read: if request.auth != null && (
        (resource.data.participantIds is list
          && request.auth.uid in resource.data.participantIds)
        || isAdmin()
      );

      allow create: if request.auth != null 
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() == 2
        && request.auth.uid in request.resource.data.participantIds;

      allow update: if request.auth != null
        && resource.data.participantIds is list
        && request.auth.uid in resource.data.participantIds;
        
      allow delete: if request.auth != null && (
        (resource.data.participantIds is list
          && request.auth.uid in resource.data.participantIds)
        || isAdmin()
      );
    }

    match /conversations/{conversationId}/messages/{messageId} {
      allow read, write: if request.auth != null && (
        request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId))
          .data.participantIds
        || isAdmin()
      );
    }

    // =========================
    // Chatting Collection (New - Efficient Message Storage)
    // =========================
    match /chatting/{chatId} {
      allow read: if request.auth != null && (
        (resource.data.participantIds is list
          && request.auth.uid in resource.data.participantIds)
        || isAdmin()
      );

      allow create: if request.auth != null
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() == 2
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.chatId == chatId;

      allow update: if request.auth != null
        && resource.data.participantIds is list
        && request.auth.uid in resource.data.participantIds;

      allow delete: if request.auth != null && (
        (resource.data.participantIds is list
          && request.auth.uid in resource.data.participantIds)
        || isAdmin()
      );
    }

    match /chatting/{chatId}/messages/{messageId} {
      function isParticipant() {
        let chatDoc = get(/databases/$(database)/documents/chatting/$(chatId));
        return request.auth != null
          && chatDoc.data.participantIds is list
          && request.auth.uid in chatDoc.data.participantIds;
      }

      allow read: if isParticipant() || isAdmin();

      allow create: if request.auth != null
        && isParticipant()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.receiverId != null
        && request.resource.data.content is string;

      allow update: if isParticipant()
        && (resource.data.senderId == request.auth.uid 
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt', 'readTimestamp', 'delivered', 'deliveredAt']));

      allow delete: if (isParticipant() && resource.data.senderId == request.auth.uid)
        || isAdmin();
    }

    // =========================
    // Legacy messages
    // =========================
    match /messages/{messageId} {
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId;

      allow read, update, delete: if request.auth != null && (
        request.auth.uid == resource.data.userId
        || isAdmin()
      );
    }

    // =========================
    // Notifications
    // =========================
    match /notifications/{notificationId} {
      allow read: if request.auth != null && (
        resource.data.recipientId == request.auth.uid 
        || resource.data.senderId == request.auth.uid
        || resource.data.userId == request.auth.uid
        || isAdmin()
      );

      allow create: if request.auth != null;
      
      allow update: if request.auth != null && (
        resource.data.recipientId == request.auth.uid
        || resource.data.userId == request.auth.uid
        || isAdmin()
      );
      
      allow delete: if request.auth != null && (
        resource.data.recipientId == request.auth.uid
        || resource.data.userId == request.auth.uid
        || isAdmin()
      );
    }

    // =========================
    // Helper functions for Reviews / Bookings
    // =========================
    function isValidReviewData() {
      return request.resource.data.rating is number
             && request.resource.data.rating >= 1
             && request.resource.data.rating <= 5
             && request.resource.data.comment is string
             && request.resource.data.comment.size() >= 10;
    }

    function hasProviderId() {
      return request.resource.data.driverId != null
             || request.resource.data.guideId != null
             || request.resource.data.providerId != null;
    }

    // =========================
    // Reviews
    // =========================
    match /reviews/{reviewId} {
      allow read: if true;
      
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId
        && isValidReviewData()
        && hasProviderId();
      
      allow update: if request.auth != null && (
        (request.auth.uid == resource.data.userId && isValidReviewData())
        ||
        (request.resource.data.diff(resource.data).changedKeys()
          .hasOnly(['likes', 'dislikes', 'likedBy', 'dislikedBy', 'lastUpdated']))
        ||
        isAdmin()
      );
      
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.userId
        || isAdmin()
      );
    }

    // =========================
    // Reported Reviews
    // =========================
    match /reportedReviews/{reportId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.reporterId
        || isAdmin()
      );
      
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.reporterId
        && request.resource.data.reviewId != null
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 5;
      
      allow update, delete: if isAdmin();
    }

    // =========================
    // Bookings
    // =========================
    match /bookings/{bookingId} {
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.customerId
        && hasProviderId()
        && request.resource.data.selectedDates is list
        && request.resource.data.totalPrice is number;

      allow read: if request.auth != null && (
        request.auth.uid == resource.data.customerId
        || request.auth.uid == resource.data.driverId
        || request.auth.uid == resource.data.guideId
        || request.auth.uid == resource.data.providerId
        || isAdmin()
      );

      allow update: if request.auth != null && (
        request.auth.uid == resource.data.customerId
        || request.auth.uid == resource.data.driverId
        || request.auth.uid == resource.data.guideId
        || request.auth.uid == resource.data.providerId
        || isAdmin()
      );

      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.customerId
        || isAdmin()
      );
    }

    // =========================
    // Confirmations
    // =========================
    match /confirmations/{confirmationId} {
      allow create: if request.auth != null;
      
      allow read, update, delete: if request.auth != null && (
        request.auth.uid == resource.data.customerId
        || request.auth.uid == resource.data.driverId
        || request.auth.uid == resource.data.guideId
        || request.auth.uid == resource.data.providerId
        || isAdmin()
      );
    }
      
    // =========================
    // Tourists (profile)
    // =========================
    match /tourists/{touristId} {
      allow read: if true;
      
      allow create: if request.auth != null
        && request.auth.uid == touristId;
      
      allow update: if request.auth != null && (
        request.auth.uid == touristId
        || isAdmin()
      )
      || (request.auth == null
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['stripeCustomerId', 'updatedAt']));
      
      allow delete: if request.auth != null && (
        request.auth.uid == touristId
        || isAdmin()
      );
    }

    // =========================
    // Service Providers
    // =========================
    match /serviceProviders/{providerId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.auth.uid == providerId
        && (!('availability' in request.resource.data) || isValidAvailabilityMap(request.resource.data.availability))
        && (!('availabilityStandard' in request.resource.data) || isValidAvailabilityMap(request.resource.data.availabilityStandard))
        && (!('availabilityLuxury' in request.resource.data) || isValidAvailabilityMap(request.resource.data.availabilityLuxury));

      allow update: if request.auth != null
        && (isOwner(providerId) || isAdmin())
        && (!('availability' in request.resource.data) || isValidAvailabilityMap(request.resource.data.availability))
        && (!('availabilityStandard' in request.resource.data) || isValidAvailabilityMap(request.resource.data.availabilityStandard))
        && (!('availabilityLuxury' in request.resource.data) || isValidAvailabilityMap(request.resource.data.availabilityLuxury));

      allow delete: if request.auth != null && (
        request.auth.uid == providerId
        || isAdmin()
      );
    }

    // =========================
    // Online Status
    // =========================
    match /onlineStatus/{userId} {
      allow read: if request.auth != null;

      allow create, update: if request.auth != null && (
        request.auth.uid == userId
        || isAdmin()
      );

      allow delete: if request.auth != null && (
        request.auth.uid == userId
        || isAdmin()
      );
    }

    // =========================
    // Jeep Driver Certifications
    // =========================
    match /jeepDriverCertifications/{userId} {
      allow read: if true;

      allow create, update: if request.auth != null && (
        (request.auth.uid == userId
          && request.resource.data.providerId == userId
          && request.resource.data.documents is list)
        || isAdmin()
      );

      allow delete: if request.auth != null && (
        request.auth.uid == userId
        || isAdmin()
      );
    }

    // =========================
    // Guide Certifications
    // =========================
    match /guideCertifications/{userId} {
      allow read: if true;

      allow create, update: if request.auth != null && (
        (request.auth.uid == userId
          && request.resource.data.providerId == userId
          && request.resource.data.documents is list)
        || isAdmin()
      );

      allow delete: if request.auth != null && (
        request.auth.uid == userId
        || isAdmin()
      );
    }

    // =========================
    // Admins Collection
    // =========================
    match /admins/{adminId} {
      allow read: if request.auth != null && (
        request.auth.uid == adminId
        || isAdmin()
      );

      allow create, update, delete: if false;
    }

    // =========================
    // Service Packages
    // =========================
    match /servicePackages/{packageId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.providerId
        && request.resource.data.title is string
        && request.resource.data.description is string
        && (
          (request.resource.data.fullDayPrice is number
            && request.resource.data.halfDayPrice is number)
          ||
          (request.resource.data.hasStandardJeep == true
            && request.resource.data.fullDayPriceStandard is number
            && request.resource.data.halfDayPriceStandard is number)
          ||
          (request.resource.data.hasLuxuryJeep == true
            && request.resource.data.fullDayPriceLuxury is number
            && request.resource.data.halfDayPriceLuxury is number)
        );

      allow update: if request.auth != null && (
        request.auth.uid == resource.data.providerId
        || isAdmin()
      );

      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.providerId
        || isAdmin()
      );
    }

    // =========================
    // Rental Products
    // =========================
    match /rentalProducts/{productId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.providerId
        && request.resource.data.title is string
        && request.resource.data.category is string
        && request.resource.data.pricePerDay is number
        && request.resource.data.quantity is number;

      allow update: if request.auth != null && (
        request.auth.uid == resource.data.providerId
        || isAdmin()
      );

      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.providerId
        || isAdmin()
      );
    }

    // =========================
    // Rentals
    // =========================
    match /rentals/{rentalId} {
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.customerId
        && request.resource.data.productId != null
        && request.resource.data.providerId != null
        && request.resource.data.startDate is string
        && request.resource.data.endDate is string;

      allow read: if request.auth != null && (
        request.auth.uid == resource.data.customerId
        || request.auth.uid == resource.data.providerId
        || isAdmin()
      );

      allow update: if request.auth != null && (
        request.auth.uid == resource.data.customerId
        || request.auth.uid == resource.data.providerId
        || isAdmin()
      );

      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.customerId
        || isAdmin()
      );
    }

    // =========================
    // User Preferences
    // =========================
    match /userPreferences/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId
        || isAdmin()
      );

      allow create, update: if request.auth != null
        && request.auth.uid == userId;

      allow delete: if request.auth != null && (
        request.auth.uid == userId
        || isAdmin()
      );
    }

    // =========================
    // User Activities
    // =========================
    match /userActivities/{activityId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.userId
        || isAdmin()
      );

      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId
        && request.resource.data.type is string
        && request.resource.data.itemId is string
        && request.resource.data.itemType is string;

      allow update: if false;

      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.userId
        || isAdmin()
      );
    }

    // =========================
    // Recently Viewed
    // =========================
    match /recentlyViewed/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId
        || isAdmin()
      );

      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.items is list;

      allow delete: if request.auth != null && (
        request.auth.uid == userId
        || isAdmin()
      );
    }

    // =========================
    // Favorites
    // =========================
    match /favorites/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId
        || isAdmin()
      );

      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.items is list;

      allow delete: if request.auth != null && (
        request.auth.uid == userId
        || isAdmin()
      );
    }

    // =========================
    // Admin Notifications
    // =========================
    match /adminNotifications/{notificationId} {
      allow read: if isAdmin();
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    // =========================
    // Admin Audit Log
    // =========================
    match /adminAuditLog/{logId} {
      allow read: if isAdmin();
      allow create: if request.auth != null;
      allow update, delete: if false;
    }
  }
}
