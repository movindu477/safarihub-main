rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================
    // 🔐 Admin Helper Function
    // =========================
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isOwner(ownerId) {
      return request.auth != null && request.auth.uid == ownerId;
    }

    // =========================
    // 📅 Availability Calendar Helpers
    // =========================
    function isValidAvailabilityStatusList(values) {
      // Firestore Rules can't iterate keys, but we *can* ensure values are only from this set.
      return values.hasOnly([
        // Explicit available statuses
        'available',
        'available-fullday',
        'available-halfday-morning',
        'available-halfday-evening',

        // Manual unavailable statuses
        'unavailable',
        'unavailable-fullday',
        'unavailable-halfday-morning',
        'unavailable-halfday-evening',

        // Booking-driven statuses (and legacy)
        'busy',
        'halfday',
        'halfday-morning',
        'halfday-evening',

        // Mixed state used in UI
        'halfbooked-halfunavailable-morning',
        'halfbooked-halfunavailable-evening'
      ]);
    }

    function isValidAvailabilityMap(m) {
      // Expected shape: { "YYYY-MM-DD": "<status>" }
      // NOTE: We validate type/size and allowed values; key-format validation isn't possible in rules.
      return m is map
        && m.size() <= 5000
        && isValidAvailabilityStatusList(m.values());
    }

    // =========================
    // Conversations (chat) - Legacy
    // =========================
    match /conversations/{conversationId} {
      // Admins or participants can read
      allow read: if request.auth != null && (
        (resource.data.participantIds is list
          && request.auth.uid in resource.data.participantIds)
        || isAdmin()
      );

      // Create conversation: exactly 2 participants and caller must be one of them
      allow create: if request.auth != null 
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() == 2
        && request.auth.uid in request.resource.data.participantIds;

      // Only participants can update, admins can delete
      allow update: if request.auth != null
        && resource.data.participantIds is list
        && request.auth.uid in resource.data.participantIds;
        
      allow delete: if request.auth != null && (
        (resource.data.participantIds is list
          && request.auth.uid in resource.data.participantIds)
        || isAdmin()
      );
    }

    // Messages inside a conversation – participants or admins can read/write
    match /conversations/{conversationId}/messages/{messageId} {
      allow read, write: if request.auth != null && (
        request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId))
          .data.participantIds
        || isAdmin()
      );
    }

    // =========================
    // Chatting Collection (New - Efficient Message Storage)
    // =========================
    match /chatting/{chatId} {
      // Participants or admins can read
      allow read: if request.auth != null && (
        (resource.data.participantIds is list
          && request.auth.uid in resource.data.participantIds)
        || isAdmin()
      );

      // Create chat: user must be one of the participants
      allow create: if request.auth != null
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() == 2
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.chatId == chatId;

      // Only participants can update
      allow update: if request.auth != null
        && resource.data.participantIds is list
        && request.auth.uid in resource.data.participantIds;

      // Participants or admins can delete
      allow delete: if request.auth != null && (
        (resource.data.participantIds is list
          && request.auth.uid in resource.data.participantIds)
        || isAdmin()
      );
    }

    // Messages inside chatting collection
    match /chatting/{chatId}/messages/{messageId} {
      function isParticipant() {
        let chatDoc = get(/databases/$(database)/documents/chatting/$(chatId));
        return request.auth != null
          && chatDoc.data.participantIds is list
          && request.auth.uid in chatDoc.data.participantIds;
      }

      // Participants or admins can read messages
      allow read: if isParticipant() || isAdmin();

      // Only participants can create messages
      allow create: if request.auth != null
        && isParticipant()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.receiverId != null
        && request.resource.data.content is string;

      // Participants can update, admins can delete
      allow update: if isParticipant()
        && (resource.data.senderId == request.auth.uid 
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt', 'readTimestamp', 'delivered', 'deliveredAt']));

      allow delete: if (isParticipant() && resource.data.senderId == request.auth.uid)
        || isAdmin();
    }

    // =========================
    // Legacy messages
    // =========================
    match /messages/{messageId} {
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId;

      // Owner or admin can read/update/delete
      allow read, update, delete: if request.auth != null && (
        request.auth.uid == resource.data.userId
        || isAdmin()
      );
    }

    // =========================
    // Notifications
    // =========================
    match /notifications/{notificationId} {
      // Users or admins can read notifications
      allow read: if request.auth != null && (
        resource.data.recipientId == request.auth.uid 
        || resource.data.senderId == request.auth.uid
        || resource.data.userId == request.auth.uid
        || isAdmin()
      );

      // Any authenticated user can create a notification
      allow create: if request.auth != null;
      
      // Receiver or admin can update
      allow update: if request.auth != null && (
        resource.data.recipientId == request.auth.uid
        || resource.data.userId == request.auth.uid
        || isAdmin()
      );
      
      // Receiver or admin can delete
      allow delete: if request.auth != null && (
        resource.data.recipientId == request.auth.uid
        || resource.data.userId == request.auth.uid
        || isAdmin()
      );
    }

    // =========================
    // Helper functions for Reviews / Bookings
    // =========================
    function isValidReviewData() {
      return request.resource.data.rating is number
             && request.resource.data.rating >= 1
             && request.resource.data.rating <= 5
             && request.resource.data.comment is string
             && request.resource.data.comment.size() >= 10;
    }

    function hasProviderId() {
      return request.resource.data.driverId != null
             || request.resource.data.guideId != null
             || request.resource.data.providerId != null;
    }

    // =========================
    // Reviews (user → driver/guide/renting provider)
    // =========================
    match /reviews/{reviewId} {
      // Anyone can read reviews
      allow read: if true;
      
      // Create: logged-in user with valid data
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId
        && isValidReviewData()
        && hasProviderId();
      
      // Update: owner can edit, anyone can like/dislike, admin can moderate
      allow update: if request.auth != null && (
        // Owner editing
        (request.auth.uid == resource.data.userId && isValidReviewData())
        ||
        // Like/dislike updates
        (request.resource.data.diff(resource.data).changedKeys()
          .hasOnly(['likes', 'dislikes', 'likedBy', 'dislikedBy', 'lastUpdated']))
        ||
        // Admin can moderate
        isAdmin()
      );
      
      // Owner or admin can delete
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.userId
        || isAdmin()
      );
    }

    // =========================
    // Reported Reviews
    // =========================
    match /reportedReviews/{reportId} {
      // Admins can read all reports, users can read their own
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.reporterId
        || isAdmin()
      );
      
      // Authenticated user can report a review
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.reporterId
        && request.resource.data.reviewId != null
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 5;
      
      // Only admins can update or delete reports (for moderation)
      allow update, delete: if isAdmin();
    }

    // =========================
    // Bookings (customer ↔ driver/guide) - UPDATED FOR PACKAGE BOOKING
    // =========================
    match /bookings/{bookingId} {
      // Customer creates booking (supports both regular and package bookings)
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.customerId
        && hasProviderId()
        && request.resource.data.selectedDates is list
        && request.resource.data.totalPrice is number;

      // Customer, provider, or admin can read
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.customerId
        || request.auth.uid == resource.data.driverId
        || request.auth.uid == resource.data.guideId
        || request.auth.uid == resource.data.providerId
        || isAdmin()
      );

      // Customer, provider, or admin can update
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.customerId
        || request.auth.uid == resource.data.driverId
        || request.auth.uid == resource.data.guideId
        || request.auth.uid == resource.data.providerId
        || isAdmin()
      );

      // Customer or admin can delete
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.customerId
        || isAdmin()
      );
    }

    // =========================
    // Confirmations
    // =========================
    match /confirmations/{confirmationId} {
      allow create: if request.auth != null;
      
      // Customer, provider, or admin can read/update/delete
      allow read, update, delete: if request.auth != null && (
        request.auth.uid == resource.data.customerId
        || request.auth.uid == resource.data.driverId
        || request.auth.uid == resource.data.guideId
        || request.auth.uid == resource.data.providerId
        || isAdmin()
      );
    }
      
    // =========================
    // Tourists (profile) - UPDATED FOR PAYMENT WALLET
    // =========================
    match /tourists/{touristId} {
      // ✅ Allow public read access (needed for backend payment operations)
      // Backend server (without auth) needs to read/update stripeCustomerId
      allow read: if true;
      
      // Owner or admin can create
      allow create: if request.auth != null && (
        request.auth.uid == touristId
        || isAdmin()
      );
      
      // Owner can update their full profile, OR
      // Backend can update payment fields (stripeCustomerId, updatedAt), OR
      // Admin can update anything
      allow update: if request.auth != null && (
        request.auth.uid == touristId
        || isAdmin()
      )
      // Allow backend (unauthenticated) to update payment-related fields only
      || (request.auth == null
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['stripeCustomerId', 'updatedAt']));
      
      // Owner or admin can delete
      allow delete: if request.auth != null && (
        request.auth.uid == touristId
        || isAdmin()
      );
    }

    // =========================
    // Service Providers (drivers, guides & renting shops) - ENHANCED
    // =========================
    match /serviceProviders/{providerId} {
      // ✅ Public profiles are readable by anyone (for guide/driver/renting listings and profiles)
      allow read: if true;

      // Provider or admin can create/update
      // Supports all field variations: destinations, destinationsCovered, certifications, etc.
      // Supports all service types: Jeep Driver, Tour Guide, Renting
      allow create, update: if request.auth != null
        && (isOwner(providerId) || isAdmin())
        // If availability fields are being written, validate their structure/values.
        && (!('availability' in request.resource.data) || isValidAvailabilityMap(request.resource.data.availability))
        && (!('availabilityStandard' in request.resource.data) || isValidAvailabilityMap(request.resource.data.availabilityStandard))
        && (!('availabilityLuxury' in request.resource.data) || isValidAvailabilityMap(request.resource.data.availabilityLuxury));

      // Provider or admin can delete
      allow delete: if request.auth != null && (
        request.auth.uid == providerId
        || isAdmin()
      );
    }

    // =========================
    // Online Status
    // =========================
    match /onlineStatus/{userId} {
      // Any logged-in user can read online status
      allow read: if request.auth != null;

      // User or admin can update status
      allow create, update: if request.auth != null && (
        request.auth.uid == userId
        || isAdmin()
      );

      // User or admin can delete
      allow delete: if request.auth != null && (
        request.auth.uid == userId
        || isAdmin()
      );
    }

    // =========================
    // Jeep Driver Certifications (Also used by Renting Shops)
    // =========================
    match /jeepDriverCertifications/{userId} {
      // ✅ Anyone can read certifications (public profile display)
      allow read: if true;

      // Provider or admin can create/update
      allow create, update: if request.auth != null && (
        (request.auth.uid == userId
          && request.resource.data.providerId == userId
          && request.resource.data.documents is list)
        || isAdmin()
      );

      // Provider or admin can delete
      allow delete: if request.auth != null && (
        request.auth.uid == userId
        || isAdmin()
      );
    }

    // =========================
    // Guide Certifications
    // =========================
    match /guideCertifications/{userId} {
      // ✅ Anyone can read certifications (public profile display)
      allow read: if true;

      // Provider or admin can create/update
      allow create, update: if request.auth != null && (
        (request.auth.uid == userId
          && request.resource.data.providerId == userId
          && request.resource.data.documents is list)
        || isAdmin()
      );

      // Provider or admin can delete
      allow delete: if request.auth != null && (
        request.auth.uid == userId
        || isAdmin()
      );
    }

    // =========================
    // 🔐 Admins Collection
    // =========================
    match /admins/{adminId} {
      // Admins can read their own profile or any admin profile
      allow read: if request.auth != null && (
        request.auth.uid == adminId
        || isAdmin()
      );

      // Admin documents are created/updated ONLY manually (Firestore Console)
      // No UI-based registration or modification allowed
      allow create, update, delete: if false;
    }

    // =========================
    // 📦 SERVICE PACKAGES (Jeep Drivers & Tour Guides) - ENHANCED
    // =========================
    match /servicePackages/{packageId} {
      // ✅ Anyone can read packages (public visibility for booking)
      allow read: if true;

      // Provider can create their own packages
      // Supports both Tour Guide (simple pricing) and Jeep Driver (vehicle-based pricing)
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.providerId
        && request.resource.data.title is string
        && request.resource.data.description is string
        // Tour Guide: Must have fullDayPrice and halfDayPrice
        && (
          (request.resource.data.fullDayPrice is number
            && request.resource.data.halfDayPrice is number)
          ||
          // Jeep Driver: Must have vehicle types and their prices
          (request.resource.data.hasStandardJeep == true
            && request.resource.data.fullDayPriceStandard is number
            && request.resource.data.halfDayPriceStandard is number)
          ||
          (request.resource.data.hasLuxuryJeep == true
            && request.resource.data.fullDayPriceLuxury is number
            && request.resource.data.halfDayPriceLuxury is number)
        );

      // Provider or admin can update
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.providerId
        || isAdmin()
      );

      // Provider or admin can delete
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.providerId
        || isAdmin()
      );
    }

    // =========================
    // 🎒 RENTAL PRODUCTS (Equipment Renting)
    // =========================
    match /rentalProducts/{productId} {
      // Anyone can read available products (public listing)
      allow read: if true;

      // Renting shop provider can create products
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.providerId
        && request.resource.data.title is string
        && request.resource.data.category is string
        && request.resource.data.pricePerDay is number
        && request.resource.data.quantity is number;

      // Provider or admin can update
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.providerId
        || isAdmin()
      );

      // Provider or admin can delete
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.providerId
        || isAdmin()
      );
    }

    // =========================
    // 🏕️ RENTALS (Equipment Rental Requests)
    // =========================
    match /rentals/{rentalId} {
      // Customer creates rental request
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.customerId
        && request.resource.data.productId != null
        && request.resource.data.providerId != null
        && request.resource.data.startDate is string
        && request.resource.data.endDate is string;

      // Customer, provider, or admin can read
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.customerId
        || request.auth.uid == resource.data.providerId
        || isAdmin()
      );

      // Customer, provider, or admin can update
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.customerId
        || request.auth.uid == resource.data.providerId
        || isAdmin()
      );

      // Customer or admin can delete
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.customerId
        || isAdmin()
      );
    }

    // =========================
    // 🎯 USER PREFERENCES (Personalization)
    // =========================
    match /userPreferences/{userId} {
      // User can read their own preferences
      allow read: if request.auth != null && (
        request.auth.uid == userId
        || isAdmin()
      );

      // User can create/update their own preferences
      allow create, update: if request.auth != null
        && request.auth.uid == userId;

      // User or admin can delete
      allow delete: if request.auth != null && (
        request.auth.uid == userId
        || isAdmin()
      );
    }

    // =========================
    // 📊 USER ACTIVITIES (Tracking)
    // =========================
    match /userActivities/{activityId} {
      // User can read their own activities, admin can read all
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.userId
        || isAdmin()
      );

      // User can create their own activities
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId
        && request.resource.data.type is string
        && request.resource.data.itemId is string
        && request.resource.data.itemType is string;

      // No direct updates allowed (activities are immutable records)
      allow update: if false;

      // User or admin can delete
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.userId
        || isAdmin()
      );
    }

    // =========================
    // 👁️ RECENTLY VIEWED
    // =========================
    match /recentlyViewed/{userId} {
      // User can read their own recently viewed
      allow read: if request.auth != null && (
        request.auth.uid == userId
        || isAdmin()
      );

      // User can create/update their own recently viewed
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.items is list;

      // User or admin can delete
      allow delete: if request.auth != null && (
        request.auth.uid == userId
        || isAdmin()
      );
    }

    // =========================
    // ❤️ FAVORITES
    // =========================
    match /favorites/{userId} {
      // User can read their own favorites
      allow read: if request.auth != null && (
        request.auth.uid == userId
        || isAdmin()
      );

      // User can create/update their own favorites
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.items is list;

      // User or admin can delete
      allow delete: if request.auth != null && (
        request.auth.uid == userId
        || isAdmin()
      );
    }

    // =========================
    // 🔔 ADMIN NOTIFICATIONS
    // =========================
    match /adminNotifications/{notificationId} {
      // Only admins can read admin notifications
      allow read: if isAdmin();

      // System can create admin notifications
      allow create: if request.auth != null;

      // Only admins can update/delete
      allow update, delete: if isAdmin();
    }

    // =========================
    // 📋 ADMIN AUDIT LOG
    // =========================
    match /adminAuditLog/{logId} {
      // Only admins can read audit logs
      allow read: if isAdmin();

      // System can create audit logs
      allow create: if request.auth != null;

      // Audit logs are immutable (no updates/deletes)
      allow update, delete: if false;
    }
  }
}
